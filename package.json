{
  "name": "loqo",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://loqo.dev",
  "repository": "git+https://github.com/SpeechifyInc/loqo.git",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:packages": "for p in sdk adapters payload; do bun run --cwd packages/$p build || exit 1; done",
    "pack:packages": "bun run build:packages && mkdir -p dist/packages && for p in sdk adapters payload; do (cd packages/$p && bun pm pack --quiet --destination ../../dist/packages) || exit 1; done"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.54",
    "@ai-sdk/openai": "^4.0.67",
    "@ai-sdk/provider": "^4.0.15",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@lezer/highlight": "^1.2.5",
    "@speechifyinc/loqo-sdk": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.11.6",
    "ai": "^7.0.102",
    "arctic": "^3.7.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@speechifyinc/loqo-adapters": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "release-please": "^17.11.2",
    "typescript": "^7.0.2"
  }
}
